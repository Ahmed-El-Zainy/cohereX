# Install as /etc/coherex-minutes.env with mode 0600. Never commit real keys.
AI_SERVICE_API_KEY=<platform-bearer-secret>

COHEREX_MINUTES_DATA_DIR=/var/lib/coherex-minutes
COHEREX_MINUTES_MAX_VIDEO_BYTES=2000000000
COHEREX_MINUTES_MAX_DURATION_SECONDS=10800

# Disk the ingester refuses to consume. Downloads start at POST but the worker
# is serial, so queued videos accumulate. Below this floor a download is
# DEFERRED (job stays QUEUED, sweep retries) rather than failed -- a full disk
# stops SQLite writes, which stops the API accepting meetings at all.
# Check `df -h /var/lib` and set this above one meeting's worth of video.
COHEREX_MINUTES_MIN_FREE_BYTES=5000000000
COHEREX_MINUTES_INGEST_SWEEP_SECONDS=60
COHEREX_MINUTES_CHUNK_SECONDS=30
COHEREX_MINUTES_ASR_TIMEOUT_SECONDS=900
COHEREX_MINUTES_SERVICE_TIMEOUT_SECONDS=600
COHEREX_MINUTES_WORKER_POLL_SECONDS=2
COHEREX_MINUTES_MAX_RETRIES=10
# Must stay in step with llama.cpp's `-c` context window: ~2.7 Arabic chars
# per token, plus COHEREX_MINUTES_LLM_MAX_TOKENS reserved for the response.
# 10000 chars + 1800 tokens fits `-c 8192`. Raise `-c` before raising this.
COHEREX_MINUTES_SLICE_CHARS=10000
COHEREX_MINUTES_LLM_MAX_TOKENS=1800
COHEREX_MINUTES_LLM_TIMEOUT_SECONDS=900
COHEREX_MINUTES_MANAGE_SERVICES=true

# Exact comma-separated hosts used by signed video URLs and their redirects.
# Keep this narrow; it is the primary SSRF boundary for background downloads.
COHEREX_VIDEO_ALLOWED_HOSTS=storage.example.com

# Both model servers must bind to 127.0.0.1.
COHEREX_VLLM_URL=http://127.0.0.1:8000
COHEREX_VLLM_API_KEY=<local-asr-secret>
COHEREX_VLLM_MODEL=CohereLabs/cohere-transcribe-arabic-07-2026
COHEREX_ASR_SERVICE=coherex-vllm

COHEREX_LLM_URL=http://127.0.0.1:8001
COHEREX_LLM_API_KEY=<local-llm-secret>
COHEREX_LLM_SERVICE=coherex-llm
