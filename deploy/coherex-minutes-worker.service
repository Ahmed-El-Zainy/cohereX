[Unit]
Description=CohereX meeting minutes FIFO worker
After=network-online.target coherex-minutes-api.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/coherex
EnvironmentFile=/etc/coherex-minutes.env
ExecStart=/opt/coherex-venv/bin/python -m coherex_minutes.worker
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
