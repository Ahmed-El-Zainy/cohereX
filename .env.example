# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real credentials. See docs/DEPLOYMENT.md for how the server is set up.

COHEREX_VLLM_URL=http://127.0.0.1:8000
COHEREX_VLLM_API_KEY=<key>

# Local LLM (llama.cpp) server — see docs/LLM_DEPLOYMENT.md. Runs on the same
# box, different port; can't be warm at the same time as the ASR server above
# (not enough RAM) — see scripts/toggle_server.sh.
COHEREX_LLM_URL=http://127.0.0.1:8001
COHEREX_LLM_API_KEY=<key>

# ssh target used by scripts/toggle_server.sh to flip between the two services
COHEREX_SERVER_SSH=root@<server-ip>

# The always-on meeting-minutes API/worker uses deploy/coherex-minutes.env.example
# on the server instead of this laptop-oriented file.
# For laptop use, point these localhost URLs at SSH local tunnels.
